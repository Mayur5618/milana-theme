{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 8px 15px; text-align: center; font-size: 13px; font-weight: 500;">
    <div class="container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
          {{ section.settings.text | escape }}
        </a>
      {%- else -%}
        <span>{{ section.settings.text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free worldwide shipping on all orders over $50 | Use code: MILANA10 for 10% OFF"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
