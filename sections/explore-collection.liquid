{%- liquid
  assign section_heading = section.settings.heading
  assign section_eyebrow = section.settings.eyebrow
-%}

<section class="section-explore-collection section-explore-collection--{{ section.id }}">
  <div class="section-explore-collection__container">
    {%- if section_eyebrow != blank or section_heading != blank -%}
      <div class="section-explore-collection__header">
        {%- if section_eyebrow != blank -%}
          <p class="section-explore-collection__eyebrow">{{ section_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section_heading != blank -%}
          <h2 class="section-explore-collection__heading">{{ section_heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="section-explore-collection__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign selected_collection = block.settings.collection
          assign card_image = block.settings.image | default: selected_collection.featured_image
          assign card_title = block.settings.title | default: selected_collection.title
          assign card_link_label = block.settings.button_label | default: 'Shop now'
        -%}

        {%- if selected_collection != blank or block.settings.image != blank -%}
          <article class="section-explore-collection__card" {{ block.shopify_attributes }}>
            {%- if selected_collection != blank -%}
              <a class="section-explore-collection__card-link" href="{{ selected_collection.url }}" aria-label="{{ card_title | escape }}">
            {%- else -%}
              <div class="section-explore-collection__card-link">
            {%- endif -%}
              {%- if card_image != blank -%}
                <img
                  class="section-explore-collection__image"
                  src="{{ card_image | image_url: width: 1200 }}"
                  alt="{{ card_image.alt | default: card_title | escape }}"
                  loading="lazy"
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                >
              {%- endif -%}
              <div class="section-explore-collection__caption">
                {%- if card_title != blank -%}
                  <h3 class="section-explore-collection__card-title">{{ card_title | escape }}</h3>
                {%- endif -%}
                <span class="section-explore-collection__card-cta">{{ card_link_label | escape }}</span>
              </div>
            {%- if selected_collection != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </article>
        {%- elsif request.design_mode -%}
          <div class="section-explore-collection__empty" {{ block.shopify_attributes }}>
            Select a collection in this card&apos;s settings
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .section-explore-collection--{{ section.id }} {
    padding: 70px 0;
    background: {{ section.settings.background_color }};
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__header {
    margin-bottom: 45px;
    text-align: center;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__eyebrow {
    margin: 0 0 6px;
    color: #777;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__heading {
    margin: 0;
    color: #111;
    font-size: 36px;
    font-weight: 700;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__card {
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__card-link {
    position: relative;
    display: block;
    height: {{ section.settings.card_height }}px;
    color: inherit;
    text-decoration: none;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__caption {
    position: absolute;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__card-title {
    margin: 0;
    color: #111;
    font-size: 18px;
    font-weight: 700;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__card-cta {
    flex: 0 0 auto;
    color: #111;
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    text-transform: uppercase;
  }

  .section-explore-collection--{{ section.id }} .section-explore-collection__empty {
    display: grid;
    min-height: 180px;
    place-items: center;
    border: 1px dashed #bbb;
    color: #555;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .section-explore-collection--{{ section.id }} {
      padding: 48px 0;
    }

    .section-explore-collection--{{ section.id }} .section-explore-collection__heading {
      font-size: 30px;
    }

    .section-explore-collection--{{ section.id }} .section-explore-collection__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .section-explore-collection--{{ section.id }} .section-explore-collection__card-link {
      height: min({{ section.settings.card_height }}px, 110vw);
    }

    .section-explore-collection--{{ section.id }} .section-explore-collection__caption {
      right: 16px;
      bottom: 16px;
      left: 16px;
      padding: 14px 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Explore Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Collection"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card image height",
      "min": 320,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 480
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Optional. Uses the collection image when left blank."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "info": "Optional. Uses the collection name when left blank."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Explore Collection Grid (Homepage 3)",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
