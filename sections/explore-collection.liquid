<section class="section-explore-collection" style="padding: 70px 0; background: #ffffff;">
  <div class="container" style="max-width: 1320px; margin: 0 auto; padding: 0 20px;">
    <div style="text-align: center; margin-bottom: 45px;">
      <span style="font-size: 13px; text-transform: uppercase; letter-spacing: 2px; color: #777;">Categories</span>
      <h2 style="font-size: 36px; font-weight: 700; color: #111; margin-top: 6px;">Explore Collection</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
      <!-- Card 1 -->
      <div style="position: relative; border-radius: 8px; overflow: hidden; height: 480px;">
        <img src="{{ 'bn1-3.jpg' | asset_url }}" alt="Bikini Collection" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='{{ 'bk141.jpg' | asset_url }}'">
        <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.9); padding: 18px 24px; border-radius: 4px; backdrop-filter: blur(4px);">
          <h3 style="font-size: 18px; margin: 0; font-weight: 700; color: #111;">Bikini Collection</h3>
          <a href="/collections/bikini" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #111; text-decoration: underline;">Shop Now</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div style="position: relative; border-radius: 8px; overflow: hidden; height: 480px;">
        <img src="{{ 'bn2-3.jpg' | asset_url }}" alt="Resort Essentials" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='{{ 'bk142.jpg' | asset_url }}'">
        <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.9); padding: 18px 24px; border-radius: 4px; backdrop-filter: blur(4px);">
          <h3 style="font-size: 18px; margin: 0; font-weight: 700; color: #111;">Resort Essentials</h3>
          <a href="/collections/resort-essentials" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #111; text-decoration: underline;">Shop Now</a>
        </div>
      </div>

      <!-- Card 3 -->
      <div style="position: relative; border-radius: 8px; overflow: hidden; height: 480px;">
        <img src="{{ 'bn3-3.jpg' | asset_url }}" alt="Summer Lookbook" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='{{ 'bk12.jpg' | asset_url }}'">
        <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.9); padding: 18px 24px; border-radius: 4px; backdrop-filter: blur(4px);">
          <h3 style="font-size: 18px; margin: 0; font-weight: 700; color: #111;">Summer Lookbook</h3>
          <a href="/collections/summer-lookbook" style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: #111; text-decoration: underline;">Shop Now</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Explore Collection",
  "settings": [],
  "presets": [
    {
      "name": "Explore Collection Grid (Homepage 3)"
    }
  ]
}
{% endschema %}
