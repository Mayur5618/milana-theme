<footer class="site-footer" style="background: #111111; color: #ffffff; padding: 60px 0 30px;">
  <div class="container" style="max-width: 1280px; margin: 0 auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 40px;">
      <div>
        <h3 style="color: #fff; font-size: 22px; font-weight: 700; margin-bottom: 16px;">Milana</h3>
        <p style="color: #999; font-size: 14px; line-height: 1.6; max-width: 320px;">
          Premium lifestyle, swimwear, and beachwear collections crafted for effortless elegance and summer comfort.
        </p>
      </div>

      <div>
        <h4 style="color: #fff; font-size: 16px; font-weight: 600; margin-bottom: 16px;">Quick Links</h4>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 2;">
          <li><a href="/collections/all" style="color: #999; text-decoration: none;">Shop All</a></li>
          <li><a href="/pages/about-us" style="color: #999; text-decoration: none;">About Us</a></li>
          <li><a href="/blogs/news" style="color: #999; text-decoration: none;">Blog</a></li>
          <li><a href="/pages/contact" style="color: #999; text-decoration: none;">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 style="color: #fff; font-size: 16px; font-weight: 600; margin-bottom: 16px;">Customer Care</h4>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 2;">
          <li><a href="/pages/frequently-asked-questions" style="color: #999; text-decoration: none;">FAQ</a></li>
          <li><a href="/pages/page-store-locations" style="color: #999; text-decoration: none;">Store Locations</a></li>
          <li><a href="/pages/page-wishlist" style="color: #999; text-decoration: none;">Wishlist</a></li>
          <li><a href="/cart" style="color: #999; text-decoration: none;">Cart</a></li>
        </ul>
      </div>

      <div>
        <h4 style="color: #fff; font-size: 16px; font-weight: 600; margin-bottom: 16px;">Newsletter</h4>
        <p style="color: #999; font-size: 14px; margin-bottom: 12px;">Subscribe to get special offers and once-in-a-lifetime deals.</p>
        <form style="display: flex;">
          <input type="email" placeholder="Enter your email" style="flex: 1; padding: 12px; border: 1px solid #333; background: #222; color: #fff; border-radius: 4px 0 0 4px;">
          <button type="submit" style="background: #FF4747; color: #fff; border: none; padding: 12px 18px; border-radius: 0 4px 4px 0; cursor: pointer; font-weight: 600;">Join</button>
        </form>
      </div>
    </div>

    <div style="border-top: 1px solid #222; padding-top: 25px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #666;">
      <div>&copy; {{ 'now' | date: "%Y" }} Milana Store. Powered by Shopify.</div>
      <div style="display: flex; gap: 10px;">
        <span style="background: #222; padding: 4px 8px; border-radius: 3px; color: #aaa;">VISA</span>
        <span style="background: #222; padding: 4px 8px; border-radius: 3px; color: #aaa;">Mastercard</span>
        <span style="background: #222; padding: 4px 8px; border-radius: 3px; color: #aaa;">PayPal</span>
        <span style="background: #222; padding: 4px 8px; border-radius: 3px; color: #aaa;">Apple Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
