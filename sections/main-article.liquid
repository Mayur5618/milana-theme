<div class="container" style="max-width: 840px; margin: 50px auto; padding: 0 20px;">
  <span style="display: block; font-size: 13px; color: #888; text-transform: uppercase; margin-bottom: 8px; text-align: center;">{{ article.published_at | date: "%B %d, %Y" }}</span>
  <h1 style="font-size: 38px; font-weight: 800; color: #111; text-align: center; margin-bottom: 30px;">{{ article.title | default: "Swimwear Trends You'll Love" }}</h1>
  
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.title }}" style="width: 100%; border-radius: 8px; margin-bottom: 30px;">
  {%- endif -%}

  <div style="font-size: 17px; line-height: 1.8; color: #333;">
    {{ article.content | default: "<p>Explore the season's newest silhouettes crafted from eco-conscious swim fabrics and designed for effortless all-day comfort.</p>" }}
  </div>

  <div style="margin-top: 50px; padding-top: 20px; border-top: 1px solid #eee;">
    <a href="{{ blog.url | default: '/blogs/news' }}" style="color: #111; font-weight: 600; text-decoration: none;">&larr; Back to Blog</a>
  </div>
</div>

{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
