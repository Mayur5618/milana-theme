<div class="container" style="max-width: 1280px; margin: 50px auto; padding: 0 20px;">
  <h1 style="font-size: 34px; font-weight: 700; text-align: center; margin-bottom: 40px;">All Collections</h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">
    {%- for collection in collections -%}
      <div style="border: 1px solid #f0f0f0; border-radius: 8px; overflow: hidden; text-align: center;">
        <a href="{{ collection.url }}" style="text-decoration: none; color: inherit;">
          {%- if collection.image -%}
            <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="{{ collection.image.width }}" height="{{ collection.image.height }}" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;">
          {%- endif -%}
          <div style="padding: 16px;">
            <h3 style="font-size: 18px; margin: 0;">{{ collection.title }}</h3>
            <span style="font-size: 13px; color: #777;">{{ collection.products_count }} products</span>
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Main List Collections",
  "settings": []
}
{% endschema %}
